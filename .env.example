# Required
DISCORD_TOKEN=your_discord_bot_token

# Optional - Health check endpoint port (default: 3000)
# HEALTH_PORT=3000

# Optional - Admin user IDs (comma-separated) for /status and /deploy commands
# ADMIN_IDS=123456789012345678,987654321098765432

# Optional - Bot presence (Playing, Streaming, Listening, Watching, Competing)
# PRESENCE_TYPE=Playing
# PRESENCE_TEXT=/help

# Optional - Logging level (trace, debug, verbose, info, warn, error, fatal, silent)
# LOG_LEVEL=info

# AI backend (self-hosted llama.cpp router — OpenAI-compatible /v1/chat/completions)
# Inside Docker, host.docker.internal resolves to the host gateway (see docker-compose.yml).
OLLAMA_API_URL=http://host.docker.internal:9068
OLLAMA_MODEL=your-model-name

# Local speech services on the host (both CPU, OpenAI-compatible)
# WHISPER_URL=http://host.docker.internal:9069   # STT  -> /v1/audio/transcriptions
# TTS_URL=http://host.docker.internal:9070       # TTS  -> /v1/audio/speech

# Self-hosted web search (SearXNG) for the chat agent's web_search tool.
# Defaults to a local instance on the host; no API key needed.
# SEARXNG_URL=http://host.docker.internal:9072

# Optional - Spotify integration (required for Spotify playlist support as background playlists)
# Get credentials at https://developer.spotify.com/dashboard
# Add http://127.0.0.1:8888/callback as a Redirect URI in your Spotify app settings
# Then run `npx tsx scripts/spotify-auth.ts` to get the refresh token
# SPOTIFY_CLIENT_ID=your_spotify_client_id
# SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token
